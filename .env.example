# Copie para .env na VPS (não commite o .env).
# docker compose --env-file .env ...

# --- docker-compose.yml (API + Postgres no mesmo servidor) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_por_senha_forte
POSTGRES_DB=crmvaxa

# JWT: mínimo 32 caracteres (igual regra do appsettings).
JWT_SECRET=troque_por_chave_longa_com_no_minimo_32_caracteres_segura
JWT_ISSUER=CRMVEXA
JWT_AUDIENCE=CRMVEXA

# --- docker-compose.api-only.yml (banco fora do Docker) ---
# CONNECTION_STRING=Host=seu-host;Port=5432;Database=crmvaxa;Username=...;Password=...
